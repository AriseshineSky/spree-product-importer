# St. Louis / America/Chicago — nightly uploads (mongo VPS, user Admin)
CRON_TZ=America/Chicago
SHELL=/bin/bash
PATH=/home/Admin/.local/bin:/usr/local/bin:/usr/bin:/bin
HOME=/home/Admin

# 23:00 STL — unified manager (Amazon CA/US/UK/AE/MX/IN/IT/PL/NL/BR; edit JOBS)
0 23 * * * /home/Admin/spree-product-importer/scripts/run_nightly_uploads.sh

# Optional single-vendor / single-source examples:
# 30 23 * * * /home/Admin/spree-product-importer/scripts/run_nightly_import.sh em-spree em-hu
# 45 23 * * * /home/Admin/spree-product-importer/scripts/run_nightly_import.sh em-spree jp-cmedia
# 0 0 * * * /home/Admin/spree-product-importer/scripts/run_nightly_import.sh em-spree topselected ebay_us
