# St. Louis / America/Chicago — nightly uploads by store + vendor name
CRON_TZ=America/Chicago
SHELL=/bin/bash
PATH=/home/Admin/.local/bin:/usr/local/bin:/usr/bin:/bin
HOME=/home/Admin

# 23:00 STL — TopSelected (amz_ca / amz_uk / ebay_us)
0 23 * * * /home/Admin/src/spree-product-importer/scripts/run_nightly_import.sh em-spree topselected

# Optional: EM-HU (aliexpress / inspireuplift)
# 30 23 * * * /home/Admin/src/spree-product-importer/scripts/run_nightly_import.sh em-spree em-hu

# Optional: JP CMedia (amz_jp)
# 45 23 * * * /home/Admin/src/spree-product-importer/scripts/run_nightly_import.sh em-spree jp-cmedia
